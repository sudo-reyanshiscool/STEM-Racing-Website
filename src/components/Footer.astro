---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__title">STEM Racing at The British School, New Delhi</p>
      <p class="site-footer__muted">Dr Jose P Rizal Marg, Chanakyapuri, New Delhi 110021</p>
    </div>
    <div>
      <p class="site-footer__label">Contacts</p>
      <p>Ms Sonica Puri, Head of STEM Racing<br /><a href="mailto:stemracing@british-school.org">stemracing@british-school.org</a></p>
      <p>Reyansh Gupta, Student Mentor<br /><a href="mailto:stemracing.mentor@british-school.org">stemracing.mentor@british-school.org</a></p>
    </div>
    <div>
      <p class="site-footer__label">Quick links</p>
      <ul>
        <li><a href="/season">Join a team</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/results">Results</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p class="site-footer__muted">&copy; {year} The British School, New Delhi. STEM Racing is the school level of the F1 in Schools competition.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    border-top: 1px solid var(--border);
    padding-block: 3rem 1.5rem;
    font-size: 0.95rem;
  }
  .site-footer__inner {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1.4fr 1fr;
    }
  }
  .site-footer__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
  }
  .site-footer__label {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .site-footer__muted {
    color: var(--text-muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    margin-top: 0.35rem;
  }
  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
</style>
