---
interface Props {
  eventEnabled: boolean;
}
const { eventEnabled } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/programme', label: 'Programme' },
  { href: '/teams', label: 'Teams' },
  { href: '/season', label: 'Season' },
  { href: '/resources', label: 'Resources' },
  { href: '/results', label: 'Results' },
];
if (eventEnabled) links.push({ href: '/event', label: 'Event' });
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="TBS STEM Racing home">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__text">
        <span class="brand__school">The British School, New Delhi</span>
        <span class="brand__name">STEM Racing</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 29, 51, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand__mark {
    width: 12px;
    height: 36px;
    background: var(--accent);
    transform: skewX(-14deg);
    border-radius: 2px;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand__school {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .brand__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .nav-toggle__bar {
    width: 22px;
    height: 2px;
    background: var(--text);
  }
  .site-nav {
    display: none;
    width: 100%;
    padding-bottom: 1rem;
  }
  .site-nav.is-open {
    display: block;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .site-nav a {
    display: block;
    padding: 0.6rem 0.75rem;
    color: var(--text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }
  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--accent);
    text-decoration: none;
    background: var(--teal-tint);
  }
  .site-nav a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  @media (min-width: 900px) {
    .nav-toggle {
      display: none;
    }
    .site-nav {
      display: block;
      width: auto;
      padding-bottom: 0;
    }
    .site-nav ul {
      flex-direction: row;
      gap: 0.25rem;
    }
  }
</style>
