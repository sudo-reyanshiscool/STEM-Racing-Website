---
// A clearly labelled box that stands in for a photo or render.
// Pass `src` to show a real image instead of the placeholder.
interface Props {
  label: string;
  src?: string;
  alt?: string;
  ratio?: string;
}
const { label, src, alt = '', ratio = '16 / 9' } = Astro.props;
---

{
  src ? (
    <img src={src} alt={alt} style={`aspect-ratio: ${ratio}; object-fit: cover; width: 100%; border-radius: var(--radius-sm);`} loading="lazy" />
  ) : (
    <div class="placeholder" style={`aspect-ratio: ${ratio};`} role="img" aria-label={`Placeholder: ${label}`}>
      <span>{label}</span>
    </div>
  )
}
