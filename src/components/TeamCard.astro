---
import type { CollectionEntry } from 'astro:content';

interface Props {
  team: CollectionEntry<'teams'>;
  level?: 'h3' | 'h4';
}

const { team, level = 'h3' } = Astro.props;
const Heading = level;
---

<article class="team card">
  <Heading>{team.data.name}</Heading>
</article>

<style>
  .team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 7rem;
    place-items: center;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    text-align: center;
  }
</style>
