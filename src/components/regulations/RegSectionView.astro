---
import type { RegSection } from '../../lib/regulations/types';
import RegBlocks from './RegBlocks.astro';
import RegSectionView from './RegSectionView.astro';

interface Props {
  section: RegSection;
  /** 2 for an article, then 3 and 4. Deeper parts stay at h4 so no level is skipped. */
  level?: 2 | 3 | 4;
}

const { section, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const next = Math.min(level + 1, 4) as 3 | 4;
---

<section class:list={['reg-section', `reg-section--l${level}`]} id={section.id} aria-labelledby={`${section.id}-h`}>
  <Heading class="reg-section__title" id={`${section.id}-h`}>
    {section.label && <span class="reg-section__label">{section.label}</span>}{' '}
    <span>{section.title}</span>
  </Heading>
  {section.blocks && section.blocks.length > 0 && <RegBlocks blocks={section.blocks} />}
  {section.children?.map((child) => <RegSectionView section={child} level={next} />)}
</section>
