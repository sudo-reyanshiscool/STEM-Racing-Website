---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'STEM Racing at The British School, New Delhi. Students design, build and race miniature cars.' } = Astro.props;

const eventEntries = await getCollection('event');
const event = eventEntries[0]?.data;
const eventEnabled = Boolean(event?.enabled);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | TBS STEM Racing</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1d33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header eventEnabled={eventEnabled} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--accent);
    color: var(--navy-900);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    z-index: 100;
  }
  .skip-link:focus {
    left: 0.5rem;
  }
</style>
