---
import Base from '../layouts/Base.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';

const roles = [
  {
    title: 'Design and Engineering',
    body: 'Model the car in CAD, test it in the wind tunnel and in CFD software, then machine and finish the body. This group owns the Technical Regulations and the engineering portfolio.',
  },
  {
    title: 'Enterprise',
    body: 'Raise sponsorship, manage the budget, build the team identity and run social media. This group produces the enterprise portfolio and the pit display.',
  },
  {
    title: 'Project Management',
    body: 'Set the schedule, run team meetings, track risks and make sure every deadline is met. The team principal usually sits here and leads the verbal presentation.',
  },
];

const contacts = [
  { name: 'Ms Sonica Puri', role: 'Head of STEM Racing', email: 'stemracing@british-school.org' },
  { name: 'Reyansh Gupta', role: 'Student Mentor', email: 'stemracing.mentor@british-school.org' },
];
---

<Base title="Programme" description="How STEM Racing works at The British School, New Delhi.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">The programme</p>
      <h1>STEM Racing at TBS</h1>
      <p class="lead">
        A school wide engineering and enterprise programme open to students in Years 8 to 12. Teams compete in the
        national STEM Racing competition, formerly known as F1 in Schools.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container split">
      <div class="prose">
        <h2>History at TBS</h2>
        <p>
          STEM Racing started at The British School in 2022 with a single Development class team and a borrowed
          launch track. The first car was cut by hand from a balsa block in the DT workshop.
        </p>
        <p>
          By 2024 the school had its own CNC router and wind tunnel, and two teams entered the Regional Finals. In
          the 2025-26 season SuperCharged became the first TBS team to reach the World Finals, finishing 14th out of
          52 teams with their car Thunder.
        </p>
        <p>
          Today the programme runs every year with several teams across both classes, supported by a Head of STEM
          Racing and student mentors drawn from previous teams.
        </p>
      </div>
      <PlaceholderImage label="Photo: first TBS team, 2022" ratio="4 / 3" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How a team works</h2>
      <p class="lead">
        Every team has between three and six members. The work splits into three areas, and every member is expected
        to contribute to more than one.
      </p>
      <div class="grid grid--3 roles">
        {
          roles.map((r) => (
            <div class="card">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2>What a season looks like</h2>
      <ol class="phases">
        <li>
          <h4>September: launch and team formation</h4>
          <p>Launch assembly, taster sessions in the workshop, and teams form. Proposal booklets go in by early October.</p>
        </li>
        <li>
          <h4>October to December: design and build</h4>
          <p>Teams confirmed after interview. CAD, wind tunnel testing and design freeze. Sponsorship letters go out.</p>
        </li>
        <li>
          <h4>January: Regional Finals</h4>
          <p>Cars are machined, finished and scrutineered. Portfolios and pit displays are completed. Teams race in New Delhi.</p>
        </li>
        <li>
          <h4>March onwards: Nationals and beyond</h4>
          <p>Qualifying teams travel to the National Finals. The national winners go on to the World Finals later in the year.</p>
        </li>
      </ol>
      <p><a class="btn" href="/season">See this season's timeline</a></p>
    </div>
  </section>

  <section class="section" id="contacts">
    <div class="container">
      <h2>Contacts</h2>
      <div class="grid grid--2">
        {
          contacts.map((c) => (
            <div class="card contact">
              <h3>{c.name}</h3>
              <p class="contact__role">{c.role}</p>
              <a href={`mailto:${c.email}`}>{c.email}</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
  }
  .roles {
    margin-top: 2rem;
  }
  .roles h3 {
    color: var(--accent);
  }
  .roles p {
    color: var(--text-muted);
  }
  .phases {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1.5rem;
    counter-reset: phase;
  }
  @media (min-width: 720px) {
    .phases {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .phases li {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: 1.5rem 1.5rem 1.5rem 4rem;
    position: relative;
    counter-increment: phase;
  }
  .phases li::before {
    content: counter(phase, decimal-leading-zero);
    position: absolute;
    left: 1.25rem;
    top: 1.35rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--accent-strong);
  }
  .contact__role {
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
</style>
