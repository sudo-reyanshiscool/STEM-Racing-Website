---
import Button from '../../components/Button.astro';
import Section from '../../components/Section.astro';
import TextTrack from '../../components/TextTrack.astro';
import Base from '../../layouts/Base.astro';
import { getRegDocs } from '../../lib/regulations';

const docs = getRegDocs();
---

<Base
  title="Regulations"
  description="The STEM Racing India National Finals regulations and guides, set out page by page with a table of contents."
>
  <Section surface="mesh" mesh="violet" priority class="page-head">
    <TextTrack slot="bleed" text="Regulations" />
  </Section>

  <Section surface="dark" labelledby="docs-title">
    <div class="stack stack--loose">
      <div class="stack">
        <h2 id="docs-title">Four documents, one place</h2>
        <p class="lead">
          Everything a team is held to at the National Finals, set out with a table of contents and a link
          on every rule. Each page follows the official regulations, which are still the documents that govern, and each has a PDF to download.
        </p>
      </div>
      <ul class="grid grid--2">
        {
          docs.map((doc, index) => (
            <li class="card stack doc-card">
              <p class="eyebrow">
                {String(index + 1).padStart(2, '0')} · {doc.edition}
              </p>
              <h3>{doc.title}</h3>
              <p>{doc.summary}</p>
              <div class="actions">
                <Button href={`/regulations/${doc.slug}`}>Read online</Button>
                <Button href={doc.pdf} variant="ghost" external>
                  PDF<span class="sr-only">: {doc.title}</span>
                </Button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Base>

<style>
  .doc-card {
    display: flex;
    flex-direction: column;
  }

  .doc-card .actions {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }
</style>
