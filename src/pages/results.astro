---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const results = await getCollection('results');
const eventOrder = { 'World Finals': 0, Nationals: 1, Regionals: 2 } as const;
const seasons = Array.from(new Set(results.map((r) => r.data.season))).sort((a, b) => b.localeCompare(a));
const inSeason = (s: string) =>
  results.filter((r) => r.data.season === s).sort((a, b) => eventOrder[a.data.event] - eventOrder[b.data.event]);

const highlights = results
  .filter((r) => r.data.event === 'World Finals' || r.data.event === 'Nationals')
  .sort((a, b) => b.data.season.localeCompare(a.data.season) || eventOrder[a.data.event] - eventOrder[b.data.event]);
---

<Base title="Results" description="STEM Racing results for The British School, New Delhi.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Results</p>
      <h1>How TBS has raced</h1>
      <p class="lead">Placings and awards from every competition a TBS team has entered.</p>

      {
        highlights.length > 0 && (
          <div class="grid grid--3 highlights">
            {highlights.map((r) => (
              <div class:list={['card', 'highlight', { 'highlight--world': r.data.event === 'World Finals' }]}>
                <span class="tag">{r.data.event}</span>
                <p class="highlight__placing">{r.data.placing}</p>
                <p class="highlight__team">
                  {r.data.team}, {r.data.season}
                </p>
                {r.data.awards.length > 0 && (
                  <ul class="highlight__awards">
                    {r.data.awards.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2>All results</h2>
      {
        seasons.map((s) => (
          <div class="season">
            <h3>{s} season</h3>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Team</th>
                    <th scope="col">Placing</th>
                    <th scope="col">Awards</th>
                  </tr>
                </thead>
                <tbody>
                  {inSeason(s).map((r) => (
                    <tr>
                      <td>{r.data.event}</td>
                      <td>{r.data.team}</td>
                      <td>{r.data.placing}</td>
                      <td>{r.data.awards.length ? r.data.awards.join(', ') : 'None'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .highlights {
    margin-top: 2.5rem;
  }
  .highlight--world {
    border-color: var(--accent);
    background: var(--teal-tint);
  }
  .highlight__placing {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0.75rem 0 0.25rem;
  }
  .highlight__team {
    color: var(--text-muted);
  }
  .highlight__awards {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .season {
    margin-top: 2rem;
  }
  .season h3 {
    margin-bottom: 0.75rem;
  }
</style>
