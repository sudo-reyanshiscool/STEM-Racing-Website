---
import { getCollection, render } from 'astro:content';
import shapeBlue from '../assets/brand/shapes/shape-blue.svg';
import Section from '../components/Section.astro';
import TextTrack from '../components/TextTrack.astro';
import Timeline from '../components/Timeline.astro';
import Base from '../layouts/Base.astro';
import { getSchool } from '../lib/content';
import { worldFinalsCount } from '../lib/results';

const school = await getSchool();
const { Content } = await render(school);
const heritage = (await getCollection('heritage')).sort(
  (a, b) => a.data.year.localeCompare(b.data.year) || a.data.team.localeCompare(b.data.team),
);
const finalsCount = worldFinalsCount((await getCollection('results')).map((entry) => entry.data));
const finalsWording = finalsCount === 1 ? 'once' : `${finalsCount} times`;
const items = heritage.map((entry) => ({
  label: entry.data.year,
  title: entry.data.team,
  description: entry.data.note,
}));
---

<Base title="Our School" description={school.data.lead}>
  <Section surface="mesh" mesh="hot" priority class="page-head">
    <TextTrack slot="bleed" text="Our School" />
  </Section>

  <Section surface="dark">
    <div class="stack stack--loose">
      <p class="eyebrow">{school.data.title}</p>
      <p class="lead">{school.data.lead}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </Section>

  <Section surface="light" labelledby="heritage-title" class="heritage-section">
    <div class="stack stack--loose">
      <div class="stack">
        <h2 id="heritage-title">TBS on the world stage</h2>
        {
          finalsCount > 0 && (
            <p class="lead">
              TBS teams have represented India at the STEM Racing World Finals {finalsWording}.
            </p>
          )
        }
      </div>
      <div class="heritage">
        <Timeline items={items} />
        <img
          class="heritage__shape"
          src={shapeBlue.src}
          width={shapeBlue.width}
          height={shapeBlue.height}
          alt=""
          loading="lazy"
        />
      </div>
    </div>
  </Section>
</Base>

<style>
  .heritage {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .heritage__shape {
    display: none;
  }

  /* The shape is drawn large and runs off the right edge of the page; the section crops it. */
  :global(.heritage-section) {
    overflow-x: clip;
  }

  @media (min-width: 64rem) {
    .heritage {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3rem;
    }

    .heritage__shape {
      display: block;
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1rem);
      z-index: -1;
      justify-self: end;
      width: 42rem;
      max-width: none;
      height: auto;
      margin-inline-end: -17rem;
      pointer-events: none;
    }
  }
</style>
