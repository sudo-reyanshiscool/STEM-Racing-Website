---
import Base from '../layouts/Base.astro';
import { getCurrentSeason, formatDate, isPast } from '../lib/season';

const season = await getCurrentSeason();
if (!season) throw new Error('Add at least one season in src/content/seasons.');

const timeline = [...season.data.timeline].sort((a, b) => a.date.localeCompare(b.date));
const { registrationOpen, registrationDeadline, year } = season.data;
const deadlinePassed = isPast(registrationDeadline);

const steps = [
  {
    title: 'Form a team of 3 to 6',
    body: 'Find people who cover design, enterprise and project management between them. Mixed year groups are welcome.',
  },
  {
    title: 'Submit the proposal booklet',
    body: 'Download the template from Resources. Fill in your roles, a first car concept and a sponsorship plan, then send it to Ms Puri.',
  },
  {
    title: 'Interview',
    body: 'A 15 minute conversation with Ms Puri and a student mentor. We want to see that you understand the workload and have a plan.',
  },
];
---

<Base title={`Season ${year}`} description={`Timeline and how to join STEM Racing at TBS for the ${year} season.`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Season {year}</p>
      <h1>The season ahead</h1>
      <p class="lead">Key dates from the launch assembly to the World Finals. Dates for external events are set by the organisers and may change.</p>
    </div>
  </section>

  <section class="section section--elevated">
    <div class="container">
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class:list={['timeline__item', { 'timeline__item--past': isPast(item.date) }]}>
              <time datetime={item.date} class="timeline__date">
                {formatDate(item.date)}
              </time>
              <div class="timeline__body">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--light" id="join">
    <div class="container">
      <p class="eyebrow">How to join</p>
      <h2>Three steps to a place on the grid</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="card">
              <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="deadline">
        <div>
          <p class="deadline__label">Proposal deadline</p>
          <p class="deadline__date">
            {formatDate(registrationDeadline)}
            {deadlinePassed && registrationOpen && <span class="tag tag--muted">Late entries accepted</span>}
          </p>
        </div>
        {
          registrationOpen ? (
            <a class="btn" href="mailto:stemracing@british-school.org?subject=STEM%20Racing%20team%20registration">
              Register
            </a>
          ) : (
            <span class="btn btn--disabled" aria-disabled="true">
              Registration closed
            </span>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
  }
  .timeline__item {
    position: relative;
    padding-left: 2.25rem;
    padding-bottom: 2.25rem;
  }
  .timeline__item:last-child {
    padding-bottom: 0;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg-elevated);
  }
  .timeline__item--past::before {
    background: var(--bg-elevated);
    border: 2px solid var(--text-muted);
  }
  .timeline__item--past .timeline__body {
    opacity: 0.7;
  }
  .timeline__date {
    display: block;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
  .timeline__body p {
    color: var(--text-muted);
    max-width: 62ch;
  }
  @media (min-width: 720px) {
    .timeline::before {
      left: 180px;
    }
    .timeline__item {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 2.5rem;
      padding-left: 0;
    }
    .timeline__item::before {
      left: 173px;
    }
    .timeline__date {
      text-align: right;
      padding-top: 0.35rem;
    }
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .steps__num {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 2rem;
    color: var(--accent-strong);
    margin-bottom: 0.25rem;
  }
  .deadline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .deadline__label {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    color: var(--text-on-light-muted);
    margin-bottom: 0.2rem;
  }
  .deadline__date {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--navy-800);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
