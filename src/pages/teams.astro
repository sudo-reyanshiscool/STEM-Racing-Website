---
import { getCollection } from 'astro:content';
import Section from '../components/Section.astro';
import TeamCard from '../components/TeamCard.astro';
import TextTrack from '../components/TextTrack.astro';
import Base from '../layouts/Base.astro';
import { groupResultsBySeason } from '../lib/results';

const stageMeta = [
  {
    stage: 'World Finals',
    summary: 'Represented India on the world stage',
  },
  {
    stage: 'Nationals',
    summary: 'Competed at the India National Finals',
  },
  {
    stage: 'Current Regionals',
    summary: 'Competing in the current regional cycle',
  },
] as const;

const teams = await getCollection('teams');
const heritage = await getCollection('heritage');
const worldFinalsYears = new Map(heritage.map((entry) => [entry.data.team, entry.data.year]));

const groups = stageMeta.map(({ stage, summary }) => {
  const inStage = teams.filter((team) => team.data.stage === stage);
  if (stage === 'World Finals') {
    inStage.sort((a, b) => {
      const yearA = worldFinalsYears.get(a.data.name) ?? '';
      const yearB = worldFinalsYears.get(b.data.name) ?? '';
      return yearA.localeCompare(yearB) || a.data.name.localeCompare(b.data.name);
    });
  }
  return {
    stage,
    summary,
    slug: stage.toLowerCase().replaceAll(' ', '-'),
    teams: inStage,
  };
});

const resultEntries = (await getCollection('results')).map((entry) => entry.data);
const results = groupResultsBySeason(resultEntries);
---

<Base
  title="Teams"
  description="Current and past STEM Racing teams at The British School, New Delhi, with their results."
>
  <Section surface="mesh" mesh="spectrum" priority class="page-head">
    <TextTrack slot="bleed" text="Our Teams" />
  </Section>

  <Section surface="dark" labelledby="teams-title">
    <div class="stack stack--loose">
      <h2 id="teams-title">Teams by stage</h2>
      <p class="lead">
        Every TBS team across the World Finals, National Finals and the current regional competition.
      </p>
      {
        groups.map((group) => (
          <section class="stage-group stack" aria-labelledby={`stage-${group.slug}`}>
            <h3 id={`stage-${group.slug}`}>{group.stage}</h3>
            <p class="eyebrow stage-group__meta">
              {group.teams.length} {group.teams.length === 1 ? 'team' : 'teams'} &middot; {group.summary}
            </p>
            <div class="grid grid--3">
              {group.teams.map((team) => (
                <TeamCard team={team} level="h4" year={worldFinalsYears.get(team.data.name)} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </Section>

  <Section surface="light" labelledby="results-title">
    <div class="stack stack--loose">
      <h2 id="results-title">Results</h2>
      {results.length === 0 && <p class="lead">Results appear here after each competition.</p>}
      {
        results.map((group) => (
          <div class="stack">
            <h3>{group.season}</h3>
            <div class="table-wrap" role="region" aria-label={`Results for ${group.season}`} tabindex="0">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Team</th>
                    <th scope="col">Placing</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <td>{row.event}</td>
                      <td>{row.team}</td>
                      <td>{row.placing}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</Base>

<style>
  .stage-group {
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--carbon-700);
  }

  .stage-group__meta {
    margin-block-start: 0.35rem;
  }
</style>
