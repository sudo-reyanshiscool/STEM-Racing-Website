---
import { getCollection } from 'astro:content';
import Section from '../components/Section.astro';
import TeamCard from '../components/TeamCard.astro';
import TextTrack from '../components/TextTrack.astro';
import Base from '../layouts/Base.astro';
import { groupResultsBySeason } from '../lib/results';

const stageOrder = ['World Finals', 'Nationals', 'Current Regionals'] as const;
const teams = await getCollection('teams');
const groups = stageOrder.map((stage) => ({
  stage,
  teams: teams.filter((team) => team.data.stage === stage),
}));
const resultEntries = (await getCollection('results')).map((entry) => entry.data);
const results = groupResultsBySeason(resultEntries);
---

<Base
  title="Teams"
  description="Current and past STEM Racing teams at The British School, New Delhi, with their results."
>
  <Section surface="mesh" priority class="page-head">
    <TextTrack slot="bleed" text="Our Teams" />
  </Section>

  <Section surface="dark" labelledby="teams-title">
    <div class="stack stack--loose">
      <h2 id="teams-title">Teams by stage</h2>
      {
        groups.map((group) => (
          <section class="stack" aria-labelledby={`stage-${group.stage.toLowerCase().replaceAll(' ', '-')}`}>
            <h3 id={`stage-${group.stage.toLowerCase().replaceAll(' ', '-')}`}>{group.stage}</h3>
            <div class="grid grid--3">
              {group.teams.map((team) => <TeamCard team={team} level="h4" />)}
            </div>
          </section>
        ))
      }
    </div>
  </Section>

  <Section surface="light" labelledby="results-title">
    <div class="stack stack--loose">
      <h2 id="results-title">Results</h2>
      {results.length === 0 && <p class="lead">Results appear here after each competition.</p>}
      {
        results.map((group) => (
          <div class="stack">
            <h3>{group.season}</h3>
            <div class="table-wrap" role="region" aria-label={`Results for ${group.season}`} tabindex="0">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Team</th>
                    <th scope="col">Placing</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <td>{row.event}</td>
                      <td>{row.team}</td>
                      <td>{row.placing}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</Base>
